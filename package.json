{
  "name": "game-shelf",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "run-p dev:*",
    "dev:client": "npm run dev -w apps/client",
    "dev:server": "npm run dev -w apps/server",
    "build": "npm run build -w apps/client",
    "start": "npm run start -w apps/server",
    "lint": "npm run lint -w apps/client"
  },
  "devDependencies": {
    "npm-run-all2": "^9.0.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
